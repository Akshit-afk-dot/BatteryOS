# Copy to services/api/.env and adjust. Every value is optional for local development.

# development | production. Production hides the API docs and expects HTTPS.
ENVIRONMENT=development

# SQLite by default (services/api/data/batteryos.db). For PostgreSQL install
# psycopg (pip install "psycopg[binary]") and use e.g.:
# DATABASE_URL=postgresql+psycopg://batteryos:secret@localhost:5432/batteryos
# DATABASE_URL=sqlite:///./data/batteryos.db

# Where original uploaded files are stored (content-addressed, read-only).
# STORAGE_DIR=./data/storage

# Apply database migrations on start-up. Set false if you run `alembic upgrade head` in deploys.
AUTO_MIGRATE=true

# Session cookie. Set COOKIE_SECURE=true whenever the site is served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=336

# Only needed if the browser calls the API directly instead of through the web app's /api proxy.
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_CSV_ROWS=500000

# AI assistant (optional). Without a key, report drafts use a deterministic
# template, quotation drafts use catalogue defaults, intake extraction uses
# pattern matching and the chat assistant is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_ENABLED=true
